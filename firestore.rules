rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function adultPath(uid) {
      return /databases/$(database)/documents/adults/$(uid);
    }

    function isActiveAdult() {
      return isSignedIn() && (
        exists(adultPath(request.auth.uid))
          ? get(adultPath(request.auth.uid)).data.active == true
          : false
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(adultPath(request.auth.uid))
          ? (
              get(adultPath(request.auth.uid)).data.active == true
              && get(adultPath(request.auth.uid)).data.role == "admin"
            )
          : false
      );
    }

    function adminExists() {
      return exists(/databases/$(database)/documents/meta/app)
        && get(/databases/$(database)/documents/meta/app).data.adminExists == true;
    }

    match /meta/app {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.adminExists == true
        && request.resource.data.firstAdminId == request.auth.uid
      );
      allow update: if isAdmin();
    }

    match /adults/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == uid
        && !adminExists()
        && request.resource.data.role == "admin"
        && request.resource.data.active == true
      );
      allow update: if isAdmin()
        || (
          isActiveAdult()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.active == resource.data.active
          && request.resource.data.studentLimit == resource.data.studentLimit
        );
      allow delete: if false;
    }

    match /classCodes/{code} {
      allow read: if isActiveAdult();
      allow create: if isAdmin()
        || (isActiveAdult() && request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if false;
    }

    match /classes/{classId} {
      allow read: if true;
      allow create: if isAdmin()
        || (isActiveAdult() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAdmin()
        || (isActiveAdult() && resource.data.ownerId == request.auth.uid);
      allow delete: if false;
    }

    match /students/{studentId} {
      allow read: if true;
      allow create: if isAdmin()
        || (isActiveAdult() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAdmin()
        || (isActiveAdult() && resource.data.ownerId == request.auth.uid)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["failCount", "locked"]);
      allow delete: if false;
    }
  }
}
