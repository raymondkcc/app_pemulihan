rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function adultPath(uid) {
      return /databases/$(database)/documents/adults/$(uid);
    }

    function isActiveAdult() {
      return isSignedIn() && (
        exists(adultPath(request.auth.uid))
          ? get(adultPath(request.auth.uid)).data.active == true
          : false
      );
    }

    function isStudentPractice(studentId) {
      return isSignedIn()
        && request.auth.uid == studentId
        && request.auth.token.practice == true
        && request.auth.token.studentId == studentId;
    }

    function ownsStudent(studentId) {
      return isActiveAdult()
        && get(/databases/$(database)/documents/students/$(studentId)).data.ownerId == request.auth.uid;
    }

    function isStudentAuth(studentId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/students/$(studentId)).data.authUid == request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(adultPath(request.auth.uid))
          ? (
              get(adultPath(request.auth.uid)).data.active == true
              && get(adultPath(request.auth.uid)).data.role == "admin"
            )
          : false
      );
    }

    function adminExists() {
      return exists(/databases/$(database)/documents/meta/app)
        && get(/databases/$(database)/documents/meta/app).data.adminExists == true;
    }

    match /meta/app {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.adminExists == true
        && request.resource.data.firstAdminId == request.auth.uid
      );
      allow update: if isAdmin();
    }

    match /adults/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == "google.com"
        && request.auth.token.email_verified == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.authProvider == "google.com"
        && request.resource.data.role == "teacher"
        && request.resource.data.active == true
      ) || (
        isSignedIn()
        && request.auth.uid == uid
        && !adminExists()
        && request.resource.data.role == "admin"
        && request.resource.data.active == true
      );
      allow update: if isAdmin()
        || (
          isActiveAdult()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.active == resource.data.active
          && request.resource.data.studentLimit == resource.data.studentLimit
        );
      allow delete: if false;
    }

    match /classCodes/{code} {
      allow read: if isActiveAdult();
      allow create: if isAdmin()
        || (isActiveAdult() && request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if false;
    }

    match /classes/{classId} {
      allow read: if true;
      allow create: if isAdmin()
        || (isActiveAdult() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAdmin()
        || (isActiveAdult() && resource.data.ownerId == request.auth.uid);
      allow delete: if false;
    }

    match /students/{studentId} {
      allow read: if true;
      allow create: if isAdmin()
        || (isActiveAdult() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAdmin()
        || (isActiveAdult() && resource.data.ownerId == request.auth.uid)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["failCount", "locked"]);
      allow delete: if false;
    }
    match /studentQrTokens/{tokenHash} {
      allow read, write: if false;
    }
    match /students/{studentId}/multiplicationFacts/{factKey} {
      allow read: if ownsStudent(studentId) || isStudentAuth(studentId);
      allow write: if isStudentAuth(studentId)
        && request.resource.data.keys().hasOnly([
          "attempts", "correct", "wrong", "currentStreak", "lastResult", "lastAnsweredAt", "nextDueAt"
        ])
        && request.resource.data.attempts is int
        && request.resource.data.correct is int
        && request.resource.data.wrong is int;
    }

    match /students/{studentId}/multiplicationSessions/{sessionId} {
      allow read: if ownsStudent(studentId) || isStudentAuth(studentId);
      allow write: if isStudentAuth(studentId)
        && request.resource.data.studentId == studentId;
    }

    match /students/{studentId}/assessmentResults/{resultId} {
      allow read: if ownsStudent(studentId) || isStudentAuth(studentId);
      allow write: if isStudentAuth(studentId)
        && request.resource.data.studentId == studentId
        && request.resource.data.subject in ["bm", "math"];
    }

  }
}
